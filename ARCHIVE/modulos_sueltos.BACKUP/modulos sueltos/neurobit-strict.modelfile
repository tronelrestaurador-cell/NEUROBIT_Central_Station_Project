FROM llama3:8b
PARAMETER num_ctx 256
PARAMETER num_thread 4
PARAMETER temperature 0.0
PARAMETER top_p 0.3
PARAMETER repeat_penalty 1.3
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""
SYSTEM """Responde SOLO con:
- [LOGOS] seguido de código Python AUTOCONTENIDO y EJECUTABLE, 
- Sin importar módulos externos si hay alternativa estándar,
- Sin explicaciones, saludos o notas.
- Si incierto: NEUROBIT: DATOS_INSUFICIENTES"""
